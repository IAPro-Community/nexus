+  grid-template-rows: minmax(0, 1fr);
+  min-height: 0;
+  min-width: 0;
+  overflow: hidden;
+}
+
+.splitPanels[data-orientation='horizontal'] {
+  grid-template-columns: minmax(0, 1fr);
+  grid-template-rows: minmax(0, var(--nx-terminal-split-ratio)) 6px minmax(0, 1fr);
+}
+
+.splitPane.splitPane {
+  /* The shared workspace panel is absolutely positioned for Tabs. In Split,
+     both live PTYs must participate in the grid as independent tracks. */
+  position: relative;
+  inset: auto;
+  width: 100%;
+  height: 100%;
+  min-width: 0;
+  min-height: 0;
+  overflow: hidden;
+}
+
+.splitPane[hidden] {
+  display: none;
+}
+
+/* The web-only workspace rule enables scrolling on every active panel.
+   A Split PTY is a fixed grid cell; the terminal owns its viewport and must
+   not inherit an extra scrollbar or reserved scrollbar gutter. */
+.splitPanels.splitPanels > .splitPane.splitPane[data-active='true'] {
+  overflow: hidden;
+  scrollbar-gutter: auto;
+}
+
+.divider {
+  min-width: 6px;
+  min-height: 6px;
+  background: var(--nx-border);
+  cursor: col-resize;
+  touch-action: none;
+}
+
+.splitPanels[data-orientation='horizontal'] .divider {
+  cursor: row-resize;
+}
