@@ -0,0 +1,93 @@
+import { describe, expect, it, vi } from 'vitest';
+import type { Agent } from '../../types';
+import {
+  startDirectSession,
+  DirectSessionSetupError,
+  type DirectSessionOperations,
+} from './directSessionLifecycle';
+
+const agent = { id: 'agent-a', project_id: 'project-a' } as Agent;
+const input = {
+  projectId: 'project-a',
+  name: 'Review agent',
+  provider: 'codex',
+  profile: 'work',
+  model: 'example-model',
+  workspace: '/repo',
+};
+
+function operations() {
+  return {
+    createAgent: vi.fn().mockResolvedValue(agent),
+    selectResource: vi.fn().mockResolvedValue({}),
+    applyAgentConfig: vi.fn().mockResolvedValue({}),
+    startAgent: vi.fn().mockResolvedValue({}),
+    deleteAgent: vi.fn().mockResolvedValue({}),
+  } satisfies DirectSessionOperations;
+}
+
+describe('Direct session transactional setup', () => {
+  it('creates, allocates, configures and starts the requested resource', async () => {
+    const api = operations();
+    await expect(startDirectSession(api, input)).resolves.toBe(agent);
+    expect(api.selectResource).toHaveBeenCalledWith('agent-a', 'codex', 'work', 'MANUAL');
+    expect(api.applyAgentConfig).toHaveBeenCalledWith(
+      'agent-a',
+      expect.objectContaining({
+        provider: 'codex',
+        profile: 'work',
+        model: 'example-model',
+        isolation: 'project',
+      }),
+    );
+    expect(api.startAgent).toHaveBeenCalledWith('agent-a');
+    expect(api.deleteAgent).not.toHaveBeenCalled();
+  });
+  it.each(['selectResource', 'applyAgentConfig'] as const)(
+    'rolls back the unstarted Agent when %s fails',
+    async (step) => {
+      const api = operations();
+      api[step].mockRejectedValue(new Error('config unavailable'));
+      await expect(startDirectSession(api, input)).rejects.toMatchObject({
+        agentId: 'agent-a',
+        recovery: 'deleted',
+      });
+      expect(api.deleteAgent).toHaveBeenCalledWith('agent-a');
+      expect(api.startAgent).not.toHaveBeenCalled();
+    },
+  );
+  it('reports failed cleanup and preserves the Agent identity for recovery', async () => {
+    const api = operations();
+    api.selectResource.mockRejectedValue(new Error('selection rejected'));
+    api.deleteAgent.mockRejectedValue(new Error('cannot delete'));
+    await expect(startDirectSession(api, input)).rejects.toMatchObject({
+      agentId: 'agent-a',
+      recovery: 'cleanup-failed',
+    });
+  });
+  it('never deletes a runtime when its start response is uncertain', async () => {
+    const api = operations();
+    api.startAgent.mockRejectedValue(new Error('network timeout'));
+    await expect(startDirectSession(api, input)).rejects.toMatchObject({
+      agentId: 'agent-a',
+      recovery: 'start-uncertain',
+    });
+    expect(api.deleteAgent).not.toHaveBeenCalled();
+  });
+  it('never cleans up an Agent when creation itself fails', async () => {
+    const api = operations();
+    api.createAgent.mockRejectedValue(new Error('create failed'));
+    await expect(startDirectSession(api, input)).rejects.toThrow('create failed');
+    expect(api.deleteAgent).not.toHaveBeenCalled();
+  });
+  it('uses the provider default model when no model is selected', async () => {
+    const api = operations();
+    await startDirectSession(api, { ...input, model: undefined });
+    const config = api.applyAgentConfig.mock.calls[0][1];
+    expect(config).not.toHaveProperty('model');
+  });
+  it('labels recoverable failures with stable identities', () => {
+    const error = new DirectSessionSetupError('failure', 'agent-a', 'start-uncertain');
+    expect(error.agentId).toBe('agent-a');
+  });
+});
diff --git a/web/src/features/work/directSessionLifecycle.ts b/web/src/features/work/directSessionLifecycle.ts
new file mode 100644
index 000000000..cf5380b88
--- /dev/null
+++ b/web/src/features/work/directSessionLifecycle.ts
@@ -0,0 +1,67 @@
+import type { Agent, AgentConfig } from '../../types';
+
+export interface DirectSessionOperations {
+  createAgent: (projectId: string, name: string, role?: string) => Promise<Agent>;
+  selectResource: (agentId: string, provider: string, profile: string, policy: string) => Promise<unknown>;
+  applyAgentConfig: (agentId: string, config: AgentConfig) => Promise<unknown>;
+  startAgent: (agentId: string) => Promise<unknown>;
+  deleteAgent: (agentId: string) => Promise<unknown>;
+}
+
+export interface DirectSessionInput {
+  projectId: string;
+  name: string;
+  provider: string;
+  profile: string;
+  model?: string;
+  workspace?: string;
+}
+
+export class DirectSessionSetupError extends Error {
+  constructor(
+    message: string,
+    readonly agentId: string,
+    readonly recovery: 'deleted' | 'cleanup-failed' | 'start-uncertain',
+  ) {
+    super(message);
+    this.name = 'DirectSessionSetupError';
+  }
+}
+
+/**
+ * A failed SELECT or CONFIG step cannot leave a newly created Agent orphaned.
+ * Once start is attempted, runtime creation may succeed despite network errors:
+ * NEVER delete that Agent without knowing its actual runtime state.
+ */
+export async function startDirectSession(
+  api: DirectSessionOperations,
+  input: DirectSessionInput,
+): Promise<Agent> {
+  const created = await api.createAgent(input.projectId, input.name, 'developer');
+  let attemptedStart = false;
+  try {
+    await api.selectResource(created.id, input.provider, input.profile, 'MANUAL');
+    await api.applyAgentConfig(created.id, {
+      provider: input.provider,
+      profile: input.profile,
+      ...(input.model ? { model: input.model } : {}),
+      workspace: input.workspace,
+      isolation: 'project',
+    });
+    attemptedStart = true;
+    await api.startAgent(created.id);
+    return created;
+  } catch (reason) {
+    const message = reason instanceof Error ? reason.message : String(reason);
+    if (attemptedStart) {
+      throw new DirectSessionSetupError(message, created.id, 'start-uncertain');
+    }
+    try {
+      await api.deleteAgent(created.id);
+    } catch (cleanupReason) {
+      const cleanup = cleanupReason instanceof Error ? cleanupReason.message : String(cleanupReason);
+      throw new DirectSessionSetupError(`${message} (cleanup: ${cleanup})`, created.id, 'cleanup-failed');
+    }
+    throw new DirectSessionSetupError(message, created.id, 'deleted');
+  }
+}
