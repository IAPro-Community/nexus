version: 1

project:
  name: nexus

workspace:
  strategy: worktree
  baseRef: HEAD
  sharedDirectories:
    - web/node_modules
  copiedFiles:
    - .env.local

setup:
  commands:
    - go mod download
    - bun install --cwd web --frozen-lockfile

validation:
  commands:
    - make quality

execution:
  defaultTarget: local

routing:
  strategy: quality-first

commands:
  - id: quality
    label: Quality checks
    description: Prepare the quality command in a supervised Project Shell.
    command: make quality
    keywords:
      - test
      - lint
  - id: unit-tests
    label: Unit tests
    description: Prepare the Go unit-test command. Review it and press Enter to run.
    command: go test ./...
    keywords:
      - test
      - go
