version: 1

project:
  name: nexus

workspace:
  strategy: worktree
  baseRef: HEAD
  sharedDirectories:
    - web/node_modules
  copiedFiles:
    - .env.local

setup:
  commands:
    - go mod download
    - bun install --cwd web --frozen-lockfile

validation:
  commands:
    - make quality

execution:
  # "local" remains the runtime default. Named targets are declarations only
  # until remote_execution is explicitly enabled and a target is selected.
  defaultTarget: local
  targets:
    - id: devbox
      kind: ssh
      location: devbox
      machineId: devbox
      workspace: /srv/nexus
      # location is an SSH config alias/host identity only. Authentication is
      # owned by the system SSH configuration; never put passwords/keys here.

routing:
  strategy: quality-first

commands:
  - id: quality
    label: Quality checks
    description: Prepare the quality command in a supervised Project Shell.
    command: make quality
    keywords:
      - test
      - lint
  - id: unit-tests
    label: Unit tests
    description: Prepare the Go unit-test command. Review it and press Enter to run.
    command: go test ./...
    keywords:
      - test
      - go
