{
  "id": "gemini",
  "binary_candidates": [
    "gemini"
  ],
  "env_keys": [
    "AI_PROFILE",
    "AI_PROVIDER",
    "GEMINI_CLI_HOME",
    "HOME",
    "PATH",
    "USERPROFILE",
    "XDG_CONFIG_HOME"
  ],
  "env_delete": null,
  "kickoff": [
    "-p",
    "{prompt}"
  ],
  "resume": [
    "-r",
    "{session}"
  ],
  "auto_approval": [
    "--approval-mode=yolo",
    "--sandbox",
    "--output-format",
    "text"
  ],
  "review_mode": [
    "--approval-mode=plan",
    "--sandbox",
    "--output-format",
    "text"
  ],
  "autonomous_isolation": "UNVERIFIED",
  "review_isolation": "UNVERIFIED",
  "quota": "LIVE_HTTP",
  "known_versions": [
    "0.28.2"
  ]
}
